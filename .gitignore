# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/

# 本地归档和新生成的报告
/data/raw/**
!/data/raw/.gitkeep
/data/processed/**
!/data/processed/.gitkeep
/outputs/**

# 数据同步日志
data/sync.log
*.log

# 临时文件
*.part
*.tmp
/.tmp/
/.test-tmp/

# 接口凭证（走环境变量，不落仓库）
.env
.env.*
!.env.example

# WorkBuddy：skill 随仓库提交，记忆与缓存不提交
.workbuddy/*
!.workbuddy/skills/

# 上游导出的原始文件
.local-data/

# 复制成 .env 后填入自己的凭证：cp .env.example .env && chmod 600 .env
# .env 不会被提交（见 .gitignore），本模板会提交，供新同事照抄格式

# 数据中台接口 appKey / appSecret（应用 workbuddy）
SCM_API_APP_KEY=
SCM_API_APP_SECRET=

# 可选：切换接口入口（默认用客户端内置的 IP）
# 两个入口路径相同，只是主机不同：
#   http://10.3.245.1:10073          （IP 直连，需有到 10.3.245.0/24 的路由）
#   http://hzsdpleasydata01p:10073   （内网域名，需内网 DNS 能解析）
# SCM_API_BASE_URL=http://hzsdpleasydata01p:10073

# 可选：走 HTTP 代理（Clash 的系统代理、公司代理、SSH 本地转发都行）
# 不配的话，Python 和 curl 都不会走系统代理——这是「浏览器能开、脚本不通」的常见原因
# SCM_API_PROXY=http://127.0.0.1:7897

# 可选：请求超时秒数，默认 10
# SCM_API_TIMEOUT=10

# 变量名固定，接口约定见 docs/入库记录接口.md。
# 填完执行 python -m connectors.procurement_inbound --check-env 验证。
# 临时覆盖某个值不必改文件，直接 SCM_API_APP_SECRET=xxx python3 ... 即可。
